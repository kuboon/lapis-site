{
  "tasks": {
    "bundle": "deno bundle --minify -o static/client.js src/client.tsx",
    "dev": "deno task bundle && deno run -A --watch scripts/dev.ts",
    "build": "deno task bundle && deno run -A scripts/build.ts",
    "check": "deno check scripts src && deno lint && deno fmt --check"
  },
  "nodeModulesDir": "auto",
  // Keep the default 24h supply-chain age check for third-party deps, but
  // exclude our own package so we can consume a just-published release.
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@kuboon/remix-ssg"]
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "jsxImportSource": "remix/ui"
  },
  "imports": {
    "remix": "npm:remix@3.0.0-beta.5",
    "@kuboon/remix-ssg": "jsr:@kuboon/remix-ssg@^0.3.0",
    "@kuboon/remix-ssg/node": "jsr:@kuboon/remix-ssg@^0.3.0/node",
    "@kuboon/md": "jsr:@kuboon/md@^0.1.0",
    "@std/front-matter": "jsr:@std/front-matter@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": {
    "exclude": ["dist", "node_modules", "static/client.js", "content"]
  },
  "lint": {
    "exclude": ["dist", "node_modules", "static/client.js"]
  }
}
